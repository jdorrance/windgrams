    {
      "sourceId": "9304",
      "name": "Mt. Hadis 300",
      "coordinates": [
        44.7074,
        40.2727
      ],
      "sourceElevationM": 1642.0,
      "elevationDatum": "unknown",
      "directionFlags": {
        "N": 0,
