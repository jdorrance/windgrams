&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2026-10-21_06:00:00','2026-10-21_06:00:00',
 end_date   = '2026-10-22_12:00:00','2026-10-22_12:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   3,
 i_parent_start    =   1,  28,
 j_parent_start    =   1,  25,
 e_we              = 100, 136,
 e_sn              = 100, 136,
 geog_data_res     = 'modis_15s+30s','usgs_3dep_3s+modis_15s',
 dx = 3000,
 dy = 3000,
 map_proj = 'lambert',
 ref_lat   =  48.55,
 ref_lon   = -122.35,
 truelat1  =  48.00,
 truelat2  =  49.00,
 stand_lon = -122.35,
 geog_data_path = '/wrf/WPS_GEOG'
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
