{
  "name": "windgrams-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev-data": "node scripts/make-dev-data.mjs",
    "dev": "node scripts/make-dev-data.mjs && astro dev",
    "build": "astro build",
    "check": "astro check && tsc -p worker/tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azohra/meteo.briefing": "0.6.2",
    "astro": "7.3.5",
    "leaflet": "1.9.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/leaflet": "1.9.22",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
