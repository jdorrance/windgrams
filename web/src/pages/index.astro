---
import { launchCountry, launchCountries } from "../lib/forecast-capabilities.ts";
import Base from "../layouts/Base.astro";
import { launches } from "../lib/catalog.ts";
import { href } from "../lib/site.ts";
const markers = launches.map((l) => ({ slug: l.slug, name: l.name, latitude: l.latitude, longitude: l.longitude, country: launchCountry(l) }));
const countries = launchCountries(launches);
const grouped = new Map<string, { region: string; country: string; launches: typeof launches }>();
for (const launch of launches) {
  const country = launchCountry(launch);
  const region = launch.region || launch.name;
  const key = `${country}:${region}`;
  const group = grouped.get(key) ?? { region, country, launches: [] };
  group.launches.push(launch);
  grouped.set(key, group);
}
const groups = [...grouped.values()];
---

<Base current="launches">
  <div class="launch-index-heading">
    <h1>Launches</h1>
    <label><span class="sr-only">Country</span><select id="launch-country" aria-label="Country">{countries.map(country => <option value={country.code}>{country.label}</option>)}</select></label>
  </div>
  <p class="muted" style="margin-top:6px">Windgrams, soundings and soaring forecasts.</p>

  <div id="launch-map" class="map" style="margin-top:20px" role="region" aria-label="Map of launches"></div>
  <script type="application/json" id="launch-markers" set:html={JSON.stringify(markers)} />

  {
    groups.map((group) => (
      <section class="state-group" data-country={group.country} hidden={group.country !== countries[0]?.code} aria-labelledby={`state-${group.country}-${group.region.toLowerCase().replace(/[^a-z]+/g, "-")}`}>
        <h2 id={`state-${group.country}-${group.region.toLowerCase().replace(/[^a-z]+/g, "-")}`}>
          {group.region} <span class="muted">{group.launches.length}</span>
        </h2>
        <div class="launch-grid">
            {group.launches.map((launch) => (
              <a class="card launch-card" href={href(`launches/${launch.slug}`)}>
                <h3>{launch.name}</h3>
              </a>
            ))}
        </div>
      </section>
    ))
  }

  <script>
    import { mountLaunchMap } from "../scripts/map.ts";
    import { mountLaunchCountries } from "../scripts/launch-countries.ts";
    mountLaunchCountries(mountLaunchMap);
  </script>
</Base>
