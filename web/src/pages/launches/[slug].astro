---
import { forecastCapabilities } from "../../lib/forecast-capabilities.ts";
import Unit from "../../components/Unit.astro";
import { launchNoteParts } from "../../lib/launch-notes.ts";
import Base from "../../layouts/Base.astro";
import { launches } from "../../lib/catalog.ts";
import { compassPoint, type Launch } from "../../lib/launches.ts";
import stationsFile from "../../data/stations.json";
import { dashboardUrl, type StationsFile } from "../../lib/station.ts";
import { href } from "../../lib/site.ts";

export function getStaticPaths() {
  return launches.map((launch) => ({ params: { slug: launch.slug }, props: { launch } }));
}

const { launch } = Astro.props as { launch: Launch };
const facing = launch.facingDeg === null ? null : compassPoint(launch.facingDeg);
const capabilities = forecastCapabilities(launch);
const zoneName = launch.timeZone;

// The weather station listed for this launch, if any, and where it is from the launch.
const stationEntry = Object.entries((stationsFile as StationsFile).stations).find(([, s]) => s.launches.includes(launch.slug));
const station = stationEntry && (() => {
  const [id, s] = stationEntry;
  const r = Math.PI / 180;
  const dy = (s.latitude - launch.latitude) * 111_320;
  const dx = (s.longitude - launch.longitude) * 111_320 * Math.cos(launch.latitude * r);
  const distanceM = Math.hypot(dx, dy);
  const bearing = compassPoint((Math.atan2(dx, dy) / r + 360) % 360);
  return { id, name: s.name, url: dashboardUrl(id), elevationFt: s.elevationFt, distanceM, bearing };
})();
---

<Base forecast title={launch.name} description={`Windgrams, soundings and soaring forecasts for ${launch.name}.`}>
  <script type="application/json" id="launch-config" set:html={JSON.stringify(launch)} />

  <section class="card windgram-card" aria-labelledby="launch-title">
    <header class="forecast-heading">
      <div class="forecast-identity">
        <h1 id="launch-title">{launch.name}</h1>
        {facing && <span class="forecast-facing">{facing}-facing</span>}
      </div>
      <div class="forecast-heading-actions">
        <button class="forecast-run-button" type="button" popovertarget="forecast-info" aria-label="Forecast details" title="Forecast date and model run">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><circle cx="12" cy="7" r=".8" fill="currentColor" stroke="none"/></svg>
        </button>
        <button class="forecast-info-button" type="button" popovertarget="launch-info">Launch info</button>
      </div>
    </header>
    <div class="forecast-toolbar">
      <span class="sr-only" id="day-label">Forecast day</span>
      <div class="forecast-days" id="day-tabs" role="group" aria-labelledby="day-label"></div>
      <label class="forecast-model">
        <span class="sr-only">Forecast model</span>
        <select id="model-select" disabled><option>Loading models…</option></select>
        <span class="forecast-model-value" aria-hidden="true">
          <span id="model-selected-name">…</span>
          <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 4.5 3 3 3-3"/></svg>
        </span>
      </label>
    </div>
    <div class="forecast-run-panel" id="forecast-info" popover role="dialog" aria-labelledby="forecast-info-title">
      <div class="card-head">
        <h2 id="forecast-info-title">Forecast details</h2>
        <button class="forecast-run-button" type="button" popovertarget="forecast-info" popovertargetaction="hide" aria-label="Close forecast details" autofocus>×</button>
      </div>
      <p id="forecast-date"></p>
      <p id="meteogram-meta"></p>
    </div>
    <h2 class="sr-only" id="meteogram-title">Soaring meteogram</h2>
    <p id="sample-notice" class="notice sample" hidden>
      Demo data · local development.
    </p>
    <p id="forecast-error" class="notice" role="alert" hidden>
      Forecast unavailable. <button id="forecast-reload" type="button" class="button secondary">Reload</button>
    </p>
    <div class="windgram-viewport">
      <div class="chart-scroll meteogram-frame" id="meteogram">
        <p class="chart-status">Loading the model forecast…</p>
      </div>
      <div class="windgram-height-axis" id="meteogram-height-axis" aria-hidden="true" hidden></div>
    </div>
    <div id="forecast-hour-panel" class="forecast-hour-panel" hidden>
      <div class="forecast-hour-controls">
        <label for="forecast-hour">Hour <output id="forecast-hour-label" for="forecast-hour"></output></label>
        <button id="windgram-full-profile" class="windgram-range" type="button" aria-pressed="false" aria-controls="meteogram" title="All heights" hidden><span class="windgram-range-track" aria-hidden="true"></span>Full height</button>
        <button id="forecast-hour-prev" type="button" aria-label="Previous forecast hour">←</button>
        <input id="forecast-hour" type="range" min="0" max="0" value="0" step="1" />
        <button id="forecast-hour-next" type="button" aria-label="Next forecast hour">→</button>
        <button id="forecast-hour-peak" type="button" title="Peak forecast w*">Strongest thermals</button>
      </div>
    </div>
    <div id="forecast-conditions-panel" class="forecast-hour-panel" hidden>
      <dl id="forecast-conditions" class="forecast-conditions"></dl>
      <p id="forecast-wind-note" class="forecast-wind-note" hidden></p>
    </div>
    <div class="windgram-key" id="meteogram-key"></div>
    <details class="windgram-details" id="meteogram-details" hidden>
      <summary>Weather details</summary>
      <div class="chart-scroll meteogram-diagnostics" id="meteogram-diagnostics"></div>
    </details>
    <details class="windgram-guide">
      <summary>Chart details</summary>
      <p>Time left to right · height MSL. Launch elevation uses terrain at the saved coordinates.</p>
      <p>Hover or tap an hour for lift top AGL. Tap outside to clear. Reference: launch terrain, or model terrain where launch elevation is unavailable.</p>
      <p>Colours: lapse rate, smoothed between layers and hours. Red/orange: rapid cooling aloft. Grey: inversion. Cyan line: freezing; snowflakes: lowest freezing level.</p>
      <p>Wind barbs point toward the wind source. Feather values follow the selected units. Faint barbs: interpolated levels. Tap a column or use left/right arrows to select an hour.</p>
      <p>White hatching: RH &gt;94%. Pale bands: model cloud ≥30%. Cloud outlines: potential condensation level. Compare with thermal reach.</p>
      <p>Paraglider ceiling: <Unit kind="lift" value={1.143} /> sink. Blue lift line: <Unit kind="lift" value={1} /> sink. Ensemble: median and middle 50% range.</p>
      <p>Palette and physical thresholds: <a href="http://wxtofly.net/windgramexplain.html">WxToFly</a>. Values follow Imperial / Metric. Rain and surface forecasts: Weather details.</p>
    </details>
  </section>

  <div class="launch-info-panel" id="launch-info" popover aria-labelledby="launch-info-title">
    <div class="card-head">
      <h2 id="launch-info-title">{launch.name} · launch info</h2>
      <button class="forecast-info-button" type="button" popovertarget="launch-info" popovertargetaction="hide" aria-label="Close launch info">Close</button>
    </div>
    {launch.region && <p class="eyebrow">{launch.region}</p>}
    <ul class="facts">
      {facing && <li>Faces <strong>{facing}</strong> ({launch.facingDeg}°)</li>}
      {launch.windMinMph !== null && launch.windMaxMph !== null && <li>Launch range <strong><Unit kind="wind" value={launch.windMinMph * .44704} numberOnly />–<Unit kind="wind" value={launch.windMaxMph * .44704} /></strong></li>}
      {launch.gustMaxMph !== null && <li>Gust limit <Unit kind="wind" value={launch.gustMaxMph * .44704} /></li>}
      {launch.source && <li>Source: <a href={launch.source.url} rel="noopener noreferrer" target="_blank">{launch.source.name}</a> · {launch.source.license}</li>}
      <li id="launch-elevation-item" hidden>Launch elevation <strong id="launch-elevation"></strong> <span class="muted" id="launch-elevation-source"></span></li>
      <li>Times in {zoneName}</li>
    </ul>
    {launch.notes && <div class="notice"><p class="muted">Site notes · launch catalogue</p><p>{launchNoteParts(launch.notes).map(part => 'text' in part ? part.text : <Unit kind={part.kind} value={part.value} />)}</p></div>}
    <a href={href()}>Browse launches →</a>
  </div>

  {station && (
    <section class="card station" id="station" aria-labelledby="station-title">
      <script type="application/json" id="station-config" set:html={JSON.stringify({ id: station.id, name: station.name, url: station.url })} />
      <div class="card-head">
        <h2 id="station-title">Weather station</h2>
        <span class="card-sub">{station.name} ({station.id}) · {station.distanceM < 150 ? "At launch" : <><Unit kind="distance" value={station.distanceM / 1000} /> {station.bearing} of launch</>} · <Unit kind="elevation" value={station.elevationFt * .3048} suffix=" MSL" /></span>
      </div>
      <p class="chart-status" id="station-status">Loading station…</p>
      <div id="station-body" hidden>
        <div class="station-now">
          <div class="station-wind">
            <svg id="station-compass" class="station-compass" viewBox="0 0 112 112" width="112" height="112" role="img" aria-label="Wind source bearing · green sector: launch window"></svg>
            <div>
              <p class="station-hero" id="station-wind" aria-live="polite"></p>
              <p class="station-gust" id="station-gust"></p>
              <p class="muted station-age" id="station-age"></p>
            </div>
          </div>
          <div class="station-verdict">
            <p class="station-headline" id="station-headline" role="status" aria-live="polite"></p>
            <ul class="findings" id="station-checks"></ul>
          </div>
        </div>
        <dl class="station-stats" id="station-stats"></dl>
        <details class="station-history" open>
          <summary>Last 12 hours</summary>
          <div id="station-chart"></div>
        </details>
      </div>
      <p class="muted station-note">
        Station observations · refresh 2 min. Launch sector {facing} ±{launch.windArcHalfWidthDeg}°.
        Verify wind at launch. <a href={station.url}>Weather Underground</a>.
      </p>
    </section>
  )}

  <section class="card" id="skewt-section" aria-labelledby="skewt-title">
    <div class="card-head">
      <h2 id="skewt-title">Sounding (Skew-T)</h2>
      <span class="card-sub" id="skewt-meta"></span>
    </div>
    <p class="chart-status" id="skewt-status">Loading the sounding…</p>
    <div id="skewt-body" hidden>
      <div class="sun-controls">
        <label class="sun-slider">
          <span class="sr-only">Hour of the sounding</span>
          <input type="range" id="skewt-hour" min="0" max="0" step="1" value="0" />
        </label>
        <output id="skewt-hour-label" for="skewt-hour" class="sun-time">–</output>
        <button type="button" class="button secondary" id="skewt-best" title="Peak forecast w*">Strongest thermals</button>
      </div>
      <p class="skewt-headline" id="skewt-headline" role="status" aria-live="polite"></p>
      <div class="skewt-layout">
        <div class="skewt-figure">
          <ul class="legend skewt-legend">
            <li><span class="key-line" style="color:var(--series-2)"></span>Temperature</li>
            <li><span class="key-line" style="color:var(--series-3)"></span>Dew point</li>
            <li><span class="key-line key-dash"></span>Rising thermal</li>
            <li><span class="key-swatch skewt-key-zone"></span>Thermal zone</li>
            <li><span class="key-swatch skewt-key-buoyant"></span>Thermal warmer than the air</li>
            <li><span class="key-swatch skewt-key-lid"></span>Inversion</li>
            <li><span class="key-swatch skewt-key-cloud"></span>Cloud layer</li>
          </ul>
          <div id="skewt-chart"></div>
        </div>
        <div class="skewt-reading">
          <h3>Sounding summary</h3>
          <ul class="findings" id="skewt-findings"></ul>
        </div>
      </div>
      <details style="margin-top:14px">
        <summary>How to read a Skew-T</summary>
        <div class="muted skewt-howto">
          <p>Height MSL. Orange: temperature. Green: dew point. Close lines: near saturation, cloud possible. Slanted grid: equal temperature.</p>
          <p>Dashed line: rising parcel. Shading: positive buoyancy. Parcel/environment crossing: thermal-top estimate. Condensation within the thermal layer: Cu potential.</p>
          <p>Temperature increasing with height: inversion. Stable layers can cap lift. Wind barbs: source direction and speed at each level.</p>
        </div>
      </details>
    </div>
  </section>

  <section class="card" id="sun-section" aria-labelledby="sun-title">
    <div class="card-head">
      <h2 id="sun-title">Sunlight on the terrain</h2>
      <span class="card-sub"><span id="sun-daylight"></span> · <span id="sun-cloud-note"></span></span>
    </div>
    <p class="chart-status" id="sun-status">Scroll here to load the sunlight map.</p>
    <div id="sun-body" hidden>
      <div class="sun-toolbar">
        <div class="segmented" id="sun-view" role="group" aria-label="View">
          <button type="button" data-view="2d" aria-pressed="true">2D map</button>
          <button type="button" data-view="3d" aria-pressed="false">3D terrain</button>
        </div>
        <label class="sun-check" id="sun-relief-label" hidden><input type="checkbox" id="sun-relief" /> Exaggerate relief ×2</label>
      </div>
      <div class="map sun-map" id="sun-map" tabindex="0" aria-label="Map of sunlight on the ground around the launch. Click a spot to see its day."></div>
      <div class="sun-3d" id="sun-3d" hidden role="img" aria-label="3D view of the terrain around the launch, coloured by the sunlight reaching each slope at the chosen time. The table below lists the same values for the selected spot.">
        <p class="chart-status sun-3d-status" id="sun-3d-status" hidden></p>
        <p class="sun-3d-sun" id="sun-3d-sun"></p>
        <p class="sun-3d-hint">Drag to turn · scroll or pinch to zoom · tap a spot for its day</p>
      </div>
      <div class="sun-controls">
        <button type="button" class="button secondary" id="sun-play" aria-pressed="false">Play</button>
        <label class="sun-slider">
          <span class="sr-only">Time of day</span>
          <input type="range" id="sun-time" min="0" max="0" step="1" value="0" />
        </label>
        <output id="sun-time-label" for="sun-time" class="sun-time">–</output>
      </div>
      <div class="sun-options">
        <div class="sun-legend" aria-label="Colour scale: sunlight in watts per square metre">
          <div class="sun-legend-bar" id="sun-legend-bar"></div>
          <div class="sun-legend-ticks" id="sun-legend-ticks"></div>
          <span class="sun-legend-unit">W/m² reaching the ground</span>
        </div>
        <div class="sun-buttons">
          <button type="button" class="button secondary" id="sun-peak" disabled>Peak</button>
          <label class="sun-check"><input type="checkbox" id="sun-clouds" checked /> Forecast clouds</label>
        </div>
      </div>
      <div class="sun-point-head">
        <strong id="sun-point"></strong>
        <button type="button" class="link-button" id="sun-reset" hidden>Back to the launch</button>
      </div>
      <p class="sun-readout" id="sun-readout" role="status" aria-live="polite"></p>
      <div class="sun-curve" id="sun-curve"></div>
      <details style="margin-top:10px">
        <summary>Table</summary>
        <table class="sun-table">
          <thead><tr><th scope="col">Time</th><th scope="col">W/m²</th></tr></thead>
          <tbody id="sun-table"></tbody>
        </table>
      </details>
      <details style="margin-top:10px">
        <summary>How this is calculated</summary>
        <p class="muted">Orange intensity: sunlight reaching the slope. Calculation uses terrain slope, aspect, horizon and sky view at 15-minute intervals. <span id="sun-terrain"></span>.</p>
        <p class="muted">Clear-atmosphere estimate. Selected model cloud cover applies uniformly across the map. Tap a slope for its daylight curve.</p>
        <p class="muted">3D terrain spacing: <span id="sun-relief-spacing">—</span>. True vertical scale; optional ×2 relief.</p>
      </details>
    </div>
  </section>

  <section class="card" aria-labelledby="nws-title" hidden={!capabilities.nws}>
    <div class="card-head">
      <h2 id="nws-title">National Weather Service forecast</h2>
      <span class="card-sub"><span id="nws-meta"></span> · <a id="nws-link" hidden>Open on weather.gov</a></span>
    </div>
    <div id="nws-charts">
      <p class="chart-status">Loading the NWS forecast…</p>
    </div>
  </section>

  <section class="card" aria-labelledby="ecmwf-title">
    <div class="card-head">
      <h2 id="ecmwf-title">ECMWF forecast</h2>
      <span class="card-sub" id="ecmwf-meta"></span>
    </div>
    <div id="ecmwf-charts">
      <p class="chart-status">Loading the ECMWF forecast…</p>
    </div>
    <details style="margin-top:14px">
      <summary>About this forecast</summary>
      <p class="muted">IFS · <Unit kind="resolution" value={9} /> surface grid. Upper winds: <Unit kind="pressure" value={850} /> and <Unit kind="pressure" value={700} />, from the 0.25° product. Mixing depth: model boundary layer. Thermal strength unavailable in this feed.
      </p>
    </details>
  </section>

  <section class="card" aria-labelledby="text-title" hidden={!capabilities.nws}>
    <div class="card-head">
      <h2 id="text-title">Forecast discussion</h2>
      <span class="card-sub">NWS bulletins · original wording and units</span>
    </div>
    <ul class="periods" id="nws-periods"></ul>
    <div class="balloon" id="balloon" hidden>
      <div class="card-head">
        <h3 id="balloon-title">Weather balloon sounding</h3>
        <span class="card-sub" id="balloon-meta"></span>
      </div>
      <div class="segmented" id="balloon-tabs" role="group" aria-labelledby="balloon-title"></div>
      <p class="skewt-headline" id="balloon-headline" role="status" aria-live="polite"></p>
      <div class="skewt-layout">
        <div class="skewt-figure">
          <ul class="legend skewt-legend" id="balloon-legend"></ul>
          <div id="balloon-chart"></div>
        </div>
        <div class="skewt-reading">
          <h3>Sounding summary</h3>
          <ul class="findings" id="balloon-findings"></ul>
        </div>
      </div>
      <p class="muted balloon-note" id="balloon-note"></p>
    </div>
    <div class="stack" id="nws-products" style="margin-top:18px"></div>
  </section>

  <script>
    import "../../scripts/launch-bootstrap.ts";
  </script>
</Base>
